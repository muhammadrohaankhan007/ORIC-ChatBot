# ==============================================================================
# SHU ORIC AI – Environment Configuration
# Salim Habib University (SHU), Karachi, Pakistan
# ==============================================================================

# AI Provider Credentials (Leave empty to use built-in offline expert domain reasoning engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External Web Search API (For live research & academic citation verification)
TAVILY_API_KEY=

# Default Active AI Provider: 'gemini' | 'openai' | 'claude' | 'local_expert'
DEFAULT_AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Server Deployment Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
